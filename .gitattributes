# Normalize text files to LF in repo
* text=auto

# Python / config / docs
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.xlsx binary
*.xls binary
*.xlsm binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary